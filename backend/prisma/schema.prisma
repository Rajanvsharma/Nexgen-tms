generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  OPS_MANAGER
  TEAM_MANAGER
  DISPATCHER
  ACCOUNT_EXEC
  CARRIER_RELATIONS
  ACCOUNTING
  COMPLIANCE
  SUPPORT
  AUDITOR
  CUSTOMER
  CARRIER
}

enum QuoteStatus {
  PENDING
  APPROVED
  REJECTED
  CONVERTED
}

enum LoadStatus {
  CREATED
  DRAFT
  BOOKED
  DISPATCHED
  DRIVER_ON_ROUTE
  LOADING
  ON_ROUTE
  IN_TRANSIT
  UNLOADING
  DELIVERED
  DELAYED
  ON_HOLD
  TONU
  DISPUTED
  CLAIMED
  INVOICING
  INVOICED
  PAYMENTS
  COLLECTION
  RECEIVED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  SCHEDULED
  PAID
  CANCELLED
}

enum CarrierStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLACKLISTED
  DNC
  IN_REVIEW
}

enum EmailLogStatus {
  PENDING
  PARSED
  QUOTE_CREATED
  SKIPPED
  FAILED
}

enum ConvStatus {
  NEW
  OPEN
  ESCALATED
  RESOLVED
  REOPENED
}

// ─── Organization (Multi-tenancy) ─────────────────────────────────────────────

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  plan                 String    @default("trial")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String    @default("trialing")
  trialEndsAt          DateTime?
  maxUsers             Int       @default(5)
  maxLoadsPerMonth     Int       @default(500)
  aiProvider           String?   @default("anthropic")
  aiApiKey             String?
  aiModel              String?
  customDomain         String?   @unique
  carrierDomain        String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  users         User[]
  teams         Team[]
  customers     Customer[]
  carriers      Carrier[]
  quotes        Quote[]
  loads         Load[]
  announcements Announcement[]
  pods             ProofOfDelivery[]
  accessorials     Accessorial[]
  webhookEndpoints WebhookEndpoint[]
  workflows        Workflow[]
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email             String             @unique
  password          String
  firstName         String
  lastName          String
  role              Role               @default(DISPATCHER)
  isActive          Boolean            @default(true)
  resetToken        String?
  resetTokenExpiry  DateTime?
  phone             String?
  totpSecret        String?
  totpEnabled       Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  teamId            String?
  team              Team?              @relation("TeamMembers", fields: [teamId], references: [id])
  managedTeam       Team[]             @relation("TeamManager")
  customerId        String?
  portalCustomer    Customer?          @relation("PortalAccount", fields: [customerId], references: [id])
  carrierId         String?
  carrierAccount    Carrier?           @relation("CarrierPortalAccount", fields: [carrierId], references: [id])
  refreshTokens     RefreshToken[]
  announcementsRead AnnouncementRead[]
  announcements     Announcement[]
  customers         Customer[]
  quotes            Quote[]
  loads             Load[]
  assignedLoads     Load[]             @relation("LoadAssignee")
  emailConfigs      EmailConfig[]
  notes             Note[]
  auditLogs         AuditLog[]
  loadAuditLogs     LoadAuditLog[]
  documents         Document[]
  ocrLogs           OcrLog[]
  conversations     Conversation[]
  convMessages      ConvMessage[]
  pods              ProofOfDelivery[]
  accessorials      Accessorial[]

  @@index([organizationId])
  @@index([teamId])
}

// ─── Teams ────────────────────────────────────────────────────────────────────

model Team {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  managerId      String?
  manager        User?        @relation("TeamManager", fields: [managerId], references: [id])
  isActive       Boolean      @default(true)
  repVisibility  String       @default("own")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  members        User[]       @relation("TeamMembers")
  loads          Load[]
  quotes         Quote[]
  customers      Customer[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── Announcements ────────────────────────────────────────────────────────────

model Announcement {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  body           String
  postedBy       String
  poster         User               @relation(fields: [postedBy], references: [id])
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  reads          AnnouncementRead[]

  @@index([organizationId])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
}

// ─── Customers ────────────────────────────────────────────────────────────────

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  zipCode        String?
  creditTerms    Int      @default(30)
  creditLimit    Float?
  notes          String?
  isActive       Boolean  @default(true)
  teamId         String?
  team           Team?    @relation(fields: [teamId], references: [id])
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  quotes         Quote[]
  loads          Load[]
  invoices       Invoice[]
  noteEntries    Note[]
  conversations  Conversation[]
  userAccounts   User[]   @relation("PortalAccount")

  @@index([organizationId])
  @@index([teamId])
}

// ─── Carriers ─────────────────────────────────────────────────────────────────

model Carrier {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  mcNumber          String
  dotNumber         String?
  email             String?
  phone             String?
  address           String?
  city              String?
  state             String?
  zipCode           String?
  equipmentTypes    String[]
  insuranceExpiry   DateTime?
  authorityExpiry   DateTime?
  w9OnFile          Boolean       @default(false)
  status            CarrierStatus @default(ACTIVE)
  contactPerson     String?
  blacklistReason   String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  lanes             CarrierLane[]
  loads             Load[]
  payments          CarrierPayment[]
  tonuRecords       TonuRecord[]
  performances      LoadPerformance[]
  noteEntries       Note[]
  conversations     Conversation[]
  portalUsers       User[]        @relation("CarrierPortalAccount")
  bids              LoadBid[]

  @@unique([mcNumber, organizationId])
  @@index([organizationId])
}

model CarrierLane {
  id          String   @id @default(cuid())
  carrierId   String
  carrier     Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  origin      String
  destination String
  equipment   String?
  rate        Float?
  lastUsed    DateTime @default(now())
  createdAt   DateTime @default(now())
}

// ─── Quotes ───────────────────────────────────────────────────────────────────

model Quote {
  id                  String      @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteNumber         String      @unique
  customerId          String
  customer            Customer    @relation(fields: [customerId], references: [id])
  status              QuoteStatus @default(PENDING)
  pickupCity          String
  pickupState         String
  deliveryCity        String
  deliveryState       String
  commodity           String?
  weight              Float?
  equipment           String
  pickupDate          DateTime?
  deliveryDate        DateTime?
  rate                Float
  specialInstructions String?
  source              String?
  teamId              String?
  team                Team?       @relation(fields: [teamId], references: [id])
  createdById         String
  createdBy           User        @relation(fields: [createdById], references: [id])
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  load                Load?

  @@index([organizationId])
  @@index([teamId])
}

// ─── Loads ────────────────────────────────────────────────────────────────────

model Load {
  id                  String     @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loadNumber          String     @unique
  quoteId             String?    @unique
  quote               Quote?     @relation(fields: [quoteId], references: [id])
  customerId          String
  customer            Customer   @relation(fields: [customerId], references: [id])
  carrierId           String?
  carrier             Carrier?   @relation(fields: [carrierId], references: [id])
  status              LoadStatus @default(CREATED)
  pickupCity          String
  pickupState         String
  deliveryCity        String
  deliveryState       String
  commodity           String?
  weight              Float?
  equipment           String
  pickupDate          DateTime?
  deliveryDate        DateTime?
  customerRate        Float
  carrierRate         Float?
  margin              Float?
  specialInstructions String?
  driverName          String?
  driverPhone         String?
  isDuplicate         Boolean    @default(false)
  trackingLat         Float?
  trackingLng         Float?
  trackingUpdatedAt   DateTime?
  trackingHistory     Json?
  teamId              String?
  team                Team?      @relation(fields: [teamId], references: [id])
  assignedTo          String?
  assignedUser        User?      @relation("LoadAssignee", fields: [assignedTo], references: [id])
  createdById         String
  createdBy           User       @relation(fields: [createdById], references: [id])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  invoice             Invoice?
  payment             CarrierPayment?
  performance         LoadPerformance?
  tonuRecord          TonuRecord?
  notes               Note[]
  documents           Document[]
  boardPostings       LoadBoardPosting[]
  conversations       Conversation[]
  pods                ProofOfDelivery[]
  accessorials        Accessorial[]
  stops               LoadStop[]
  auditLog            LoadAuditLog[]
  bids                LoadBid[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, pickupDate])
  @@index([customerId])
  @@index([teamId])
  @@index([assignedTo])
}

// ─── Accounting ───────────────────────────────────────────────────────────────

model Invoice {
  id                  String           @id @default(cuid())
  invoiceNumber       String           @unique
  loadId              String           @unique
  load                Load             @relation(fields: [loadId], references: [id])
  customerId          String
  customer            Customer         @relation(fields: [customerId], references: [id])
  amount              Float
  status              InvoiceStatus    @default(DRAFT)
  dueDate             DateTime?
  paidDate            DateTime?
  notes               String?
  isFactored          Boolean          @default(false)
  factoringCompanyId  String?
  factoringCompany    FactoringCompany? @relation(fields: [factoringCompanyId], references: [id])
  factoringFee        Float?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model CarrierPayment {
  id          String        @id @default(cuid())
  loadId      String        @unique
  load        Load          @relation(fields: [loadId], references: [id])
  carrierId   String
  carrier     Carrier       @relation(fields: [carrierId], references: [id])
  amount      Float
  status      PaymentStatus @default(PENDING)
  dueDate     DateTime?
  paidDate    DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ─── Carrier Bids ─────────────────────────────────────────────────────────────

model LoadBid {
  id        String    @id @default(cuid())
  loadId    String
  load      Load      @relation(fields: [loadId], references: [id], onDelete: Cascade)
  carrierId String
  carrier   Carrier   @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  amount    Float?
  notes     String?
  status    BidStatus @default(PENDING)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([loadId, carrierId])
  @@index([loadId])
  @@index([carrierId])
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// ─── Email Integration ────────────────────────────────────────────────────────

model EmailConfig {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  host         String
  port         Int       @default(993)
  username     String
  password     String
  folder       String    @default("INBOX")
  isActive     Boolean   @default(true)
  lastChecked  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model EmailLog {
  id          String         @id @default(cuid())
  messageId   String         @unique
  subject     String
  fromEmail   String
  fromName    String?
  receivedAt  DateTime
  bodyText    String
  parsedData  Json?
  status      EmailLogStatus @default(PENDING)
  quoteId     String?
  errorMsg    String?
  createdAt   DateTime       @default(now())
}

// ─── Carrier Quality ──────────────────────────────────────────────────────────

model LoadPerformance {
  id                String   @id @default(cuid())
  loadId            String   @unique
  load              Load     @relation(fields: [loadId], references: [id], onDelete: Cascade)
  carrierId         String
  carrier           Carrier  @relation(fields: [carrierId], references: [id])
  scheduledPickup   DateTime?
  actualPickup      DateTime?
  scheduledDelivery DateTime?
  actualDelivery    DateTime?
  pickupOnTime      Boolean?
  deliveryOnTime    Boolean?
  hasDetention      Boolean  @default(false)
  detentionHours    Float?
  hasClaim          Boolean  @default(false)
  claimAmount       Float?
  rating            Int?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TonuRecord {
  id          String   @id @default(cuid())
  carrierId   String
  carrier     Carrier  @relation(fields: [carrierId], references: [id])
  loadId      String?  @unique
  load        Load?    @relation(fields: [loadId], references: [id])
  date        DateTime @default(now())
  amount      Float    @default(0)
  reason      String?
  notes       String?
  createdAt   DateTime @default(now())
}

// ─── Factoring ────────────────────────────────────────────────────────────────

model FactoringCompany {
  id           String    @id @default(cuid())
  name         String
  contactEmail String?
  contactPhone String?
  ratePercent  Float     @default(3.0)
  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  invoices     Invoice[]
}

// ─── Communication / Notes ────────────────────────────────────────────────────

model Note {
  id         String    @id @default(cuid())
  body       String
  loadId     String?
  load       Load?     @relation(fields: [loadId], references: [id], onDelete: Cascade)
  carrierId  String?
  carrier    Carrier?  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  createdAt  DateTime  @default(now())
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  action         String
  entity         String
  entityId       String?
  detail         String?
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ─── Load Audit Log ───────────────────────────────────────────────────────────

model LoadAuditLog {
  id          String   @id @default(cuid())
  loadId      String
  load        Load     @relation(fields: [loadId], references: [id], onDelete: Cascade)
  action      String   // "assigned" | "reassigned" | "status_changed"
  fromValue   String?
  toValue     String?
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([loadId])
}

// ─── Webhooks ─────────────────────────────────────────────────────────────────

model WebhookEndpoint {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String
  secret         String
  events         String[]
  isActive       Boolean           @default(true)
  description    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deliveries     WebhookDelivery[]

  @@index([organizationId])
}

model WebhookDelivery {
  id                String          @id @default(cuid())
  webhookEndpointId String
  endpoint          WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)
  event             String
  payload           Json
  statusCode        Int?
  responseBody      String?
  success           Boolean         @default(false)
  attemptCount      Int             @default(0)
  nextRetryAt       DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime        @default(now())

  @@index([webhookEndpointId])
  @@index([createdAt])
}

// ─── Documents ────────────────────────────────────────────────────────────────

model Document {
  id              String    @id @default(cuid())
  type            String
  loadId          String?
  load            Load?     @relation(fields: [loadId], references: [id], onDelete: Cascade)
  filename        String
  createdById     String
  createdBy       User      @relation(fields: [createdById], references: [id])
  createdAt       DateTime  @default(now())
  signatureToken  String?   @unique
  signedAt        DateTime?
  signerName      String?
  signerEmail     String?
  signatureData   String?   @db.Text
}

// ─── Load Board Postings ──────────────────────────────────────────────────────

model LoadBoardPosting {
  id        String   @id @default(cuid())
  loadId    String
  load      Load     @relation(fields: [loadId], references: [id], onDelete: Cascade)
  board     String
  postingId String?
  status    String   @default("POSTED")
  postedAt  DateTime @default(now())
  removedAt DateTime?
}

// ─── White Label / Branding ───────────────────────────────────────────────────

model BrandingConfig {
  id            String    @id @default(cuid())
  domain        String?   @unique
  companyName   String    @default("NexGen TMS")
  tagline       String    @default("Transportation Management System")
  logoData      String?   @db.Text
  primaryColor  String    @default("#3b82f6")
  darkColor     String    @default("#1d4ed8")
  sidebarBg     String    @default("#0d1b2a")
  accentColor   String    @default("#22c55e")
  plan          String    @default("enterprise")
  planExpiresAt DateTime?
  contactName   String?
  contactEmail  String?
  isActive      Boolean   @default(true)
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── Agent Logs ───────────────────────────────────────────────────────────────

model AgentLog {
  id          String   @id @default(cuid())
  agentName   String
  status      String   @default("RUNNING")
  summary     String?
  findings    Int      @default(0)
  actions     Int      @default(0)
  error       String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
}

// ─── OCR Upload Logs ──────────────────────────────────────────────────────────

model OcrLog {
  id          String   @id @default(cuid())
  filename    String
  parsedData  Json?
  status      String   @default("PENDING")
  quoteId     String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// ─── Communication Console ────────────────────────────────────────────────────

model Conversation {
  id          String      @id @default(cuid())
  subject     String
  status      ConvStatus  @default(NEW)
  priority    String      @default("NORMAL")
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  loadId      String?
  load        Load?       @relation(fields: [loadId], references: [id])
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  carrierId   String?
  carrier     Carrier?    @relation(fields: [carrierId], references: [id])
  messages    ConvMessage[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ConvMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  attachmentName String?
  isInternal     Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

// ─── Proof of Delivery ────────────────────────────────────────────────────────

model ProofOfDelivery {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loadId         String
  load           Load         @relation(fields: [loadId], references: [id], onDelete: Cascade)
  filename       String
  fileUrl        String
  fileSize       Int?
  podType        String       @default("POD")
  notes          String?
  uploadedById   String
  uploadedBy     User         @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([loadId])
  @@index([organizationId])
}

// ─── Accessorial Charges ──────────────────────────────────────────────────────

model Accessorial {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loadId         String
  load           Load         @relation(fields: [loadId], references: [id], onDelete: Cascade)
  type           String
  amount         Float
  billTo         String       @default("CUSTOMER")
  description    String?
  approved       Boolean      @default(false)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([loadId])
  @@index([organizationId])
}

// ─── Load Stops (Multi-stop) ──────────────────────────────────────────────────

model LoadStop {
  id              String    @id @default(cuid())
  loadId          String
  load            Load      @relation(fields: [loadId], references: [id], onDelete: Cascade)
  sequence        Int
  type            String    @default("STOP")
  city            String
  state           String
  address         String?
  zipCode         String?
  contactName     String?
  contactPhone    String?
  appointmentDate DateTime?
  notes           String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([loadId])
}

// ─── Workflow Automation ──────────────────────────────────────────────────────

model Workflow {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  active         Boolean       @default(true)
  trigger        String        // load_created | load_status_changed | carrier_assigned | daily_scan
  conditionType  String        @default("always")
  conditionValue String?       // e.g. "10" for margin%, "30" for days
  actions        Json          @default("[]")
  totalRuns      Int           @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  runs           WorkflowRun[]

  @@index([organizationId])
  @@index([organizationId, trigger, active])
}

model WorkflowRun {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status     String   // success | skipped | failed
  summary    String?
  context    Json?
  runAt      DateTime @default(now())

  @@index([workflowId])
  @@index([runAt])
}
